{
  "name": "typewire",
  "version": "0.0.0",
  "private": true,
  "description": "TypeWire — a family of strongly-typed, contract-first packages (typed HTTP/WS/gRPC/GraphQL clients, a query layer, and transport-agnostic devtools). Packages ship under the @tahanabavi/* npm scope.",
  "author": {
    "name": "Taha Nabavi",
    "email": "sayyedtahanabavi@gmail.com",
    "url": "https://www.tahanabavi.ir"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TahaNabavi/typewire.git"
  },
  "homepage": "https://github.com/TahaNabavi/typewire#readme",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "size": "node scripts/size-budget.mjs",
    "size:update": "node scripts/size-budget.mjs --update",
    "deps:assert": "node scripts/assert-no-deps.mjs",
    "smoke": "node scripts/runtime-smoke.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:init": "node scripts/init-docs.mjs",
    "verify": "pnpm -r build && pnpm -r typecheck && pnpm -r test && pnpm size && pnpm deps:assert && pnpm smoke && pnpm docs:check",
    "web:dev": "pnpm --filter @typewire/web dev",
    "web:build": "pnpm --filter @typewire/web build:site",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "zod": "^4.1.5"
  }
}
