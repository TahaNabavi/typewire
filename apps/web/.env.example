# Copy to `.env` for development — not `.env.local`.
#
# Next reads both, but the Prisma tooling reads only `.env`:
# `scripts/prisma-schema.mjs` and `prisma.config.ts` load that file by name, so
# a DATABASE_URL living in `.env.local` is visible to the app and invisible to
# `db:push`, `db:studio` and `generate`. One file avoids the split.
#
# On Vercel these are project environment variables; the two storage blocks are
# injected by the marketplace integrations, so you only paste the rest yourself.
#
# Nothing here is required to run the site. Every consumer degrades: no
# DATABASE_URL means no history, no Upstash means no live counters, no
# ADMIN_PASSWORD means the panel refuses to sign anyone in.

# --- Neon Postgres (Vercel → Storage → Neon) -------------------------------
# Durable history: pageviews, feedback, daily snapshots.
DATABASE_URL=

# --- Upstash Redis (Vercel → Storage → Upstash) ----------------------------
# Live counters, unique-visitor HyperLogLogs, rate limits. Production path.
#
# Set nothing here on Vercel. The marketplace integration injects the same two
# values under its own names — UPSTASH_KV_REST_API_URL and
# UPSTASH_KV_REST_API_TOKEN — and lib/redis.ts reads those too (along with the
# older KV_REST_API_* pair). Copying a secret into a second variable to satisfy
# a name is how the two drift apart later.
#
# Not UPSTASH_KV_REST_API_READ_ONLY_TOKEN: every counter here is a write.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Redis over TCP (local development) ------------------------------------
# The same counters against a Redis you run yourself, for when there is no
# Upstash to point at. REST wins when both are configured; setting REDIS_HOST
# is what turns this path on, and the port defaults to 6379.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# --- Panel -----------------------------------------------------------------
# The password you type at /admin/login.
ADMIN_PASSWORD=
# Signs the session cookie. Any long random string: openssl rand -base64 32
ADMIN_SECRET=

# --- Analytics -------------------------------------------------------------
# Salts the daily visitor hash. Changing it resets visitor identity, which is
# the point: no stable identifier ever exists. openssl rand -base64 24
ANALYTICS_SALT=

# --- Ask the docs ----------------------------------------------------------
# Without a key /api/ask still answers: it searches the docs and streams the
# best-matching section verbatim, labelled as an excerpt. With one, a model
# answers from those same excerpts. Retrieval and citations work either way.
ANTHROPIC_API_KEY=

# --- Site address ----------------------------------------------------------
# The origin every canonical URL, og:url, sitemap entry and JSON-LD @id is built
# from. No trailing slash. Inlined at build time, so changing it needs a rebuild
# rather than a restart. Defaults to the production domain when unset.
NEXT_PUBLIC_SITE_URL=https://typewire.tahanabavi.ir

# --- Search consoles -------------------------------------------------------
# Public meta tags that prove ownership of the domain. Both optional; an unset
# variable emits no tag rather than an empty one.
# Google Search Console -> Settings -> Ownership verification -> HTML tag
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools -> Site -> Verify -> Meta tag (the msvalidate.01 value)
BING_SITE_VERIFICATION=

# --- Optional --------------------------------------------------------------
# Lifts GitHub's 60 req/hour unauthenticated limit during builds.
GITHUB_TOKEN=
# Set by Vercel automatically when you add a cron secret; the snapshot route
# rejects unsigned calls when this is present.
CRON_SECRET=
