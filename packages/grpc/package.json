{
  "name": "@tahanabavi/typefetch-grpc",
  "version": "0.1.1",
  "private": false,
  "description": "gRPC transport for TypeFetch contracts — Connect unary JSON out of the box, binary grpc-web behind a codec seam, zero dependencies.",
  "author": {
    "name": "Taha Nabavi",
    "email": "sayyedtahanabavi@gmail.com",
    "url": "https://www.tahanabavi.ir"
  },
  "license": "MIT",
  "keywords": [
    "typewire",
    "typefetch",
    "grpc",
    "grpc-web",
    "connect",
    "connectrpc",
    "transport",
    "zod",
    "type-safe",
    "api-client"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "@tahanabavi/typefetch": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tahanabavi/typefetch": "workspace:*",
    "@types/node": "^24.3.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "zod": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TahaNabavi/typewire.git",
    "directory": "packages/grpc"
  },
  "bugs": {
    "url": "https://github.com/TahaNabavi/typewire/issues"
  },
  "homepage": "https://typewire.tahanabavi.ir/docs/typefetch-grpc",
  "publishConfig": {
    "access": "public"
  }
}
