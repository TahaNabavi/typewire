{
  "name": "@tahanabavi/typefetch-encryption",
  "version": "0.1.0",
  "private": false,
  "description": "Field-level request/response encryption middleware for TypeFetch contracts (AES, DES, RSA, Base64, custom).",
  "author": {
    "name": "Taha Nabavi",
    "email": "sayyedtahanabavi@gmail.com",
    "url": "https://www.tahanabavi.ir"
  },
  "license": "MIT",
  "keywords": [
    "typewire",
    "typefetch",
    "encryption",
    "middleware",
    "aes",
    "rsa",
    "crypto",
    "field-level",
    "zod"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "peerDependencies": {
    "@tahanabavi/typefetch": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tahanabavi/typefetch": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "zod": "^4.1.5",
    "@types/crypto-js": "^4.2.2",
    "@types/node-forge": "^1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TahaNabavi/typewire.git",
    "directory": "packages/encryption"
  },
  "bugs": {
    "url": "https://github.com/TahaNabavi/typewire/issues"
  },
  "homepage": "https://typewire.tahanabavi.ir/docs/typefetch-encryption",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "node-forge": "^1.4.0"
  }
}
